# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=5000
NODE_ENV=development

# ==============================================================================
# Database Configuration (PostgreSQL 15+)
# Replace YOUR_DB_PASSWORD with your local PostgreSQL password.
# On Windows, PostgreSQL often runs on port 5433 or 5432.
# ==============================================================================
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5433/voice_agent_db?schema=public"

# ==============================================================================
# Authentication & Security Secrets
# Generate a strong 64-character random string for production
# ==============================================================================
JWT_SECRET="development-insecure-secret-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="24h"

# ==============================================================================
# Telephony Provider Configuration
# Mode: "mock" (zero-credential local evaluation) or "retell" (live cloud Retell AI)
# ==============================================================================
PROVIDER_MODE="mock"

# Retell AI Credentials (only required if PROVIDER_MODE=retell)
RETELL_API_KEY="your_retell_api_key_here"

# Retell Webhook Key (Optional: only if different from RETELL_API_KEY)
# If your Retell API key has the "Webhook" badge enabled, it acts as the webhook signing key
RETELL_WEBHOOK_KEY=""

# Retell Purchased/Registered From-Number in E.164 format (e.g. +14155551234)
RETELL_FROM_NUMBER="+14155551234"

# ==============================================================================
# CORS Configuration
# Allowed Frontend Origins (comma-separated if multiple)
# ==============================================================================
CORS_ORIGIN="http://localhost:5173"
